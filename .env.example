# Copy to .env.local and fill in real values. This file is committed as a
# template (see the !.env.example opt-in in .gitignore); .env.local is NOT.
# Never put real secrets in this file.

# --- Firebase web app config (Firebase Console → Project settings → Your apps) ---
# Public client identifiers — safe to expose, required at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Server-only Firebase Admin credential ---
# Full JSON of a Firebase service account key, on ONE line.
# (Firebase Console → Project settings → Service accounts → Generate new private key)
# REQUIRED in production: without it the grade API refuses all tokens and user
# progress is never saved. Keep the real value in .env.local / Vercel env only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Embedded simulator tools (/tools) ---
# URLs of the deployed simulator apps embedded as iframes. Leave blank to show
# the "not configured" empty state. In local dev, run each app and point here:
#   NEXT_PUBLIC_NIKA_URL=http://localhost:3001   (nikaVSimulator — FPGA / Verilog)
#   NEXT_PUBLIC_STM_URL=http://localhost:3002    (stmVSimulator  — MCU / C)
NEXT_PUBLIC_NIKA_URL=
NEXT_PUBLIC_STM_URL=
